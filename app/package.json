{
  "name": "podcast-studio",
  "productName": "Podcast Studio",
  "version": "0.2.7",
  "description": "Turn raw interview recordings into an edited episode, transcript and captions - on your own computer.",
  "main": "main.js",
  "author": "Jordon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.13"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "uk.co.askjordon.podcaststudio",
    "productName": "Podcast Studio",
    "artifactName": "PodcastStudio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../runtime",
        "to": "runtime"
      },
      {
        "from": "../third_party",
        "to": "third_party"
      }
    ],
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nodroj3991",
        "repo": "podcast-studio"
      }
    ]
  }
}